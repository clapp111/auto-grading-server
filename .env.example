# 이 파일을 복사해서 사용하세요
# 로컬: cp .env.example .env
# EC2 prod: cp .env.example .env.prod
# EC2 dev:  cp .env.example .env.dev

# App
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database (docker-compose 서비스명 기준)
DATABASE_URL=postgresql://postgres:postgres@db:5432/autograding
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autograding

# Redis / Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=uploads

# S3 (STORAGE_BACKEND=s3 일 때만 사용)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
