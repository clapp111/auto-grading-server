# 이 파일을 복사해서 사용하세요
# 로컬: cp .env.example .env
# EC2 prod: cp .env.example .env.prod
# EC2 dev:  cp .env.example .env.dev

# App
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database (로컬: localhost:5435 / EC2 Docker 내부: db:5432)
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/autograding
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=autograding

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=uploads
APP_BASE_URL=http://localhost:8000

# S3 (STORAGE_BACKEND=s3 일 때만 사용)
S3_BUCKET=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CDN_BASE_URL=  # CloudFront URL (예: https://d1234abcd.cloudfront.net)
